<?xml version="1.0" encoding="UTF-8"?>
<!--
  IMPORTANT: replace https://example.com below with your real domain once
  Kpet is deployed (see also constants.ts' API_ORIGIN and index.html's
  og:url-equivalent tags, which need the same update). Only the public,
  content pages are listed here — login/register/carrito/favoritos/mon-compte
  are account/checkout pages with nothing for a search engine to index.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://example.com/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://example.com/blog</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://example.com/distribuidores</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://example.com/terminos</loc>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
  <url>
    <loc>https://example.com/privacidad</loc>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
</urlset>
